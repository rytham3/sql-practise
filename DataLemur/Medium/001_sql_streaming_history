WITH songs_weekly AS (
    SELECT 
          user_id,
          song_id,
          COUNT(*) AS song_plays
    FROM songs_weekly
    WHERE listen_time < '2022-08-05'
    GROUP BY user_id, song_id
),


combined_data AS (
    SELECT 
          user_id,
          song_id,
          song_plays
    FROM songs_history
    
    UNION ALL 
    
    SELECT
          user_id,
          song_id,
          song_plays
    FROM songs_weekly
)

SELECT 
      user_id,
      song_id,
      SUM(song_plays) AS song_plays
FROM combined_data
GROUP BY user_id, song_id
ORDER BY song_plays DESC;
